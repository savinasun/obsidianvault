{
  "database": "Zotero",
  "noteImportFolder": "",
  "pdfExportImageDPI": 120,
  "pdfExportImageFormat": "jpg",
  "pdfExportImageQuality": 90,
  "citeFormats": [
    {
      "name": "Journal of Machine Learning",
      "format": "formatted-citation",
      "cslStyle": "journal-of-universal-computer-science"
    }
  ],
  "exportFormats": [
    {
      "name": "Literature Source Note",
      "outputPathTemplate": "_references/_literatures/@{{citekey}}.md",
      "imageOutputPathTemplate": "_references/_literatures/_attachments_{{citekey}}.md",
      "imageBaseNameTemplate": "image",
      "templatePath": "_templates/literature-source-template.md",
      "cslStyle": "journal-of-universal-computer-science"
    }
  ],
  "citeSuggestTemplate": "[[{{citekey}}]]",
  "openNoteAfterImport": true,
  "whichNotesToOpenAfterImport": "first-imported-note"
}